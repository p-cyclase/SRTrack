--label:SRTrack
--information:SRTrack Object 0.1.1 by p_cyclase
--file@file:SRT ファイル
--track@source_duration:全長,0,86400,0,0.001
--check@preview:字幕プレビュー,true

-- SRTrack Object keeps SRT timing metadata for SRTrack Exporter.
-- Its optional preview is for editing only and is deliberately blank while saving.

local function parse_timestamp(value)
    local h, m, s, ms = value:match("^%s*(%d+):(%d+):(%d+)[,.](%d+)%s*$")
    local fraction = value:match("[,.](%d+)%s*$")
    h, m, s, ms = tonumber(h), tonumber(m), tonumber(s), tonumber(ms)
    if not h or not m or not s or not ms or not fraction or m >= 60 or s >= 60 then
        return nil
    end
    if #fraction == 1 then
        ms = ms * 100
    elseif #fraction == 2 then
        ms = ms * 10
    end
    return ((h * 60 + m) * 60 + s) * 1000 + ms
end

local function parse_srt(bytes)
    bytes = bytes:gsub("^\239\187\191", ""):gsub("\r\n", "\n"):gsub("\r", "\n")
    local captions = {}
    for block in (bytes .. "\n\n"):gmatch("(.-)\n\n") do
        local lines = {}
        for line in (block .. "\n"):gmatch("(.-)\n") do
            lines[#lines + 1] = line
        end
        local timing_line
        local timing_index
        for index, line in ipairs(lines) do
            if line:find("%-%->") then
                timing_line, timing_index = line, index
                break
            end
        end
        if timing_line then
            local left, right = timing_line:match("^%s*(.-)%s*%-%-%>%s*(.-)%s*$")
            local start, finish = left and parse_timestamp(left), right and parse_timestamp(right)
            if start and finish and finish > start then
                local text = table.concat(lines, "\n", timing_index + 1)
                if text ~= "" then
                    captions[#captions + 1] = { start = start, finish = finish, text = text }
                end
            end
        end
    end
    return captions
end

local function read_srt_bytes(path)
    local ok, module = pcall(function() return obj.module("SRTrack") end)
    if not ok or not module or not module.read_utf8_file then
        return nil, "SRTrack.mod2 を読み込めません"
    end
    local read_ok, bytes = pcall(module.read_utf8_file, path)
    if not read_ok then
        return nil, bytes
    end
    return bytes, nil
end

local function global_preview_enabled()
    local ok, module = pcall(function() return obj.module("SRTrack") end)
    if not ok or not module or not module.preview_enabled then
        return true
    end
    local read_ok, enabled = pcall(module.preview_enabled)
    return not read_ok or enabled ~= false
end

local function preview_text(captions, source_time)
    local active = {}
    for _, caption in ipairs(captions or {}) do
        if caption.start > source_time then
            break
        end
        if caption.start <= source_time and source_time < caption.finish then
            active[#active + 1] = caption.text
        end
    end
    return table.concat(active, "\n")
end

local function draw_preview(text, color, outline)
    obj.setfont("MS UI Gothic", 48, 3, color, outline, true)
    obj.load("text", text, 0, 0, 4)
    obj.draw()
end

local function clear_preview()
    obj.load("text", "")
    obj.draw()
end

local function draw_notice(text)
    draw_preview("[SRTrack: 注意] " .. text, 0xffa040, 0x403000)
end

local function draw_setting(text)
    draw_preview("[SRTrack: 設定] " .. text, 0xffff80, 0x404000)
end

local function draw_read_failure(text)
    draw_preview("[SRTrack: 読み込みに失敗] " .. text, 0xff8080, 0x400000)
end

-- obj.getvalue(layer, ...) reads the Object present on that layer at the
-- current frame.  Search upward so filters and other non-video Objects can
-- stay between SRTrack Object and its nearest upper video Object.
local function nearest_upper_video_state()
    if not obj.layer or obj.layer <= 1 then
        return nil, "上側に動画 Object がありません"
    end
    for video_layer = obj.layer - 1, 1, -1 do
        -- Lua exposes the left (start) handle of the built-in video's playback
        -- range.  The right handle is represented by the video Object's timeline
        -- length, which the paired SRTrack Object shares; it therefore needs no
        -- separate value for Preview.
        local range = obj.getvalue(video_layer, "動画ファイル", "再生位置")
        if range ~= nil then
            local speed = obj.getvalue(video_layer, "動画ファイル", "再生速度")
            local loop_value = obj.getvalue(video_layer, "動画ファイル", "ループ再生")
            local position = tonumber(range)
            speed = tonumber(speed)
            if not position or not speed or speed == 0 or loop_value == nil then
                return nil, "上側の動画の再生設定を取得できません"
            end
            local object_start = tonumber(obj.getvalue("frame_s"))
            local video_start = tonumber(obj.getvalue("layer" .. video_layer .. ".frame_s"))
            local frame_rate = tonumber(obj.framerate) or tonumber(obj.getpoint("framerate"))
            if not object_start or not video_start or not frame_rate or frame_rate <= 0 then
                return nil, "上側の動画との開始位置差を取得できません"
            end
            local loop = loop_value == true or loop_value == 1 or loop_value == "1" or loop_value == "true"
            return {
                position = position,
                speed = speed,
                loop = loop,
                offset = (object_start - video_start) / frame_rate,
            }
        end
    end
    return nil, "上側に動画 Object がありません"
end

local function midpoint_aware_source_time()
    local ok, module = pcall(function() return obj.module("SRTrack") end)
    local object_start = tonumber(obj.frame_s)
    local current_frame = tonumber(obj.frame)
    local frame_rate = tonumber(obj.framerate) or tonumber(obj.getpoint("framerate"))
    if not ok or not module or not module.preview_source_time
        or not obj.layer or not object_start or not current_frame or not frame_rate then
        return nil
    end
    local read_ok, source_time = pcall(module.preview_source_time,
        obj.layer, object_start + current_frame, frame_rate)
    if not read_ok then
        return nil
    end
    return tonumber(source_time)
end

if obj.getinfo("saving") or not preview or not global_preview_enabled() then
    clear_preview()
elseif not file or file == "" then
    draw_setting("SRT ファイルが指定されていません")
else
    local state, state_error = nearest_upper_video_state()
    if not state then
        if state_error == "上側に動画 Object がありません" then
            draw_notice(state_error)
        else
            draw_read_failure(state_error)
        end
        return
    end
    local cache_prefix = "__srtrack_preview_" .. obj.id
    local path_key = cache_prefix .. "_path"
    local bytes_key = cache_prefix .. "_bytes"
    local error_key = cache_prefix .. "_error"
    if global[path_key] ~= file then
        global[path_key] = file
        local bytes, message = read_srt_bytes(file)
        global[bytes_key] = bytes or ""
        global[error_key] = message or ""
    end

    local message = global[error_key] or ""
    local bytes = global[bytes_key] or ""
    if message ~= "" then
        draw_read_failure(message)
    else
        local captions = parse_srt(bytes)
        if #captions == 0 and bytes ~= "" then
            draw_read_failure("有効な SRT 字幕が見つかりません")
        else
            local source_time = midpoint_aware_source_time()
            if source_time == nil then
                source_time = state.position * 1000
                    + (state.speed / 100) * (state.offset + obj.time) * 1000
            end
            local in_range = true
            if state.loop then
                if not source_duration or source_duration <= 0 then
                    draw_setting("ループ再生には全長が必要です")
                    return
                end
                source_time = source_time % (source_duration * 1000)
                in_range = true
            end
            local text = in_range and preview_text(captions, source_time) or ""
            if text == "" then
                clear_preview()
            else
                draw_preview("[SRTrack] " .. text, 0xffffff, 0x000000)
            end
        end
    end
end
