--label:SRTrack
--information:SRTrack Object (txt) 0.1.1 by p_cyclase
--text@text:テキスト
--check@preview:字幕プレビュー,true

local function clear()
    obj.load("text", "")
    obj.draw()
end

local function global_preview_enabled()
    local ok, module = pcall(function() return obj.module("SRTrack") end)
    if not ok or not module or not module.preview_enabled then
        return true
    end
    local read_ok, enabled = pcall(module.preview_enabled)
    return not read_ok or enabled ~= false
end

if obj.getinfo("saving") or not preview or not global_preview_enabled() or not text or text == "" then
    clear()
else
    obj.setfont("MS UI Gothic", 48, 3, 0xffffff, 0x400000, true)
    obj.load("text", "[SRTrack] " .. text, 0, 0, 4)
    obj.draw()
end
