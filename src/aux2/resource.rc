#include <windows.h>
101 DIALOGEX 0, 0, 290, 316
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SRTrack Exporter"
FONT 9, "Yu Gothic UI"
BEGIN
    GROUPBOX "対象範囲", -1, 8, 5, 274, 32
    AUTORADIOBUTTON "シーン全体", 1010, 17, 18, 90, 12, WS_GROUP
    AUTORADIOBUTTON "レイヤーを指定", 1011, 125, 18, 120, 12
    GROUPBOX "出力時刻範囲", -1, 8, 40, 274, 32
    AUTORADIOBUTTON "シーン全体", 1018, 17, 53, 90, 12, WS_GROUP
    AUTORADIOBUTTON "タイムラインの選択範囲", 1019, 125, 53, 135, 12
    LTEXT "レイヤー番号（例: 3, 5, 8-10）", -1, 10, 78, 200, 11
    EDITTEXT 1001, 10, 90, 270, 14, ES_AUTOHSCROLL
    LTEXT "レイヤー名（1行に1件、完全一致）", -1, 10, 109, 250, 11
    EDITTEXT 1012, 10, 122, 270, 47, ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    GROUPBOX "対象オブジェクト", -1, 8, 174, 274, 45
    AUTOCHECKBOX "標準テキスト", 1013, 17, 186, 100, 12
    AUTOCHECKBOX "セリフ準備", 1014, 145, 186, 105, 12
    AUTOCHECKBOX "SRTrack Object", 1017, 17, 201, 150, 12
    LTEXT "オフセット（秒）", -1, 10, 230, 110, 12
    EDITTEXT 1002, 153, 227, 82, 14, ES_AUTOHSCROLL
    LTEXT "短い字幕の結合閾値（秒）", -1, 10, 250, 140, 12
    EDITTEXT 1015, 153, 247, 82, 14, ES_AUTOHSCROLL
    LTEXT "末尾の最小表示時間（秒）", -1, 10, 270, 140, 12
    EDITTEXT 1016, 153, 267, 82, 14, ES_AUTOHSCROLL
    PUSHBUTTON "次へ", 1020, 173, 295, 50, 14
    PUSHBUTTON "キャンセル", IDCANCEL, 230, 295, 50, 14
END

102 DIALOGEX 0, 0, 292, 141
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SRTrack Importer 設定"
FONT 9, "Yu Gothic UI"
BEGIN
    AUTOCHECKBOX "動画ファイルドロップ時、同名の SRT ファイルがあれば読み込む", 2001, 10, 10, 270, 12
    GROUPBOX "SRT ファイル単体のドロップ", -1, 8, 30, 276, 49
    AUTOCHECKBOX "次の Object として読み込む", 2002, 17, 43, 150, 12
    AUTORADIOBUTTON "SRTrack Object", 2003, 31, 57, 110, 12, WS_GROUP
    AUTORADIOBUTTON "SRTrack Object (Standalone)", 2004, 148, 57, 130, 12
    LTEXT "取込設定の変更は、AviUtl2 を再起動した後のファイルドロップから反映されます。", -1, 10, 91, 272, 20
    DEFPUSHBUTTON "OK", IDOK, 174, 117, 50, 14
    PUSHBUTTON "キャンセル", IDCANCEL, 232, 117, 50, 14
END
