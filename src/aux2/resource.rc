#include <windows.h>
101 DIALOGEX 0, 0, 290, 296
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SRTrack Exporter"
FONT 9, "Yu Gothic UI"
BEGIN
    CONTROL "", 1030, "SysTabControl32", WS_VISIBLE | WS_TABSTOP, 8, 5, 274, 264
    DEFPUSHBUTTON "エクスポート…", 1020, 202, 275, 80, 14
END

103 DIALOGEX 0, 0, 266, 215
STYLE WS_CHILD | DS_CONTROL
FONT 9, "Yu Gothic UI"
BEGIN
    GROUPBOX "対象時間範囲", 1031, 8, 5, 250, 30
    AUTORADIOBUTTON "シーン全体", 1018, 17, 17, 90, 12, WS_GROUP
    AUTORADIOBUTTON "フレーム範囲選択", 1019, 120, 17, 135, 12
    GROUPBOX "対象レイヤー", 1032, 8, 39, 250, 89
    AUTORADIOBUTTON "すべてのレイヤー", 1010, 17, 51, 100, 12, WS_GROUP
    AUTORADIOBUTTON "レイヤーを指定する", 1011, 125, 51, 120, 12
    LTEXT "番号（例: 3, 5, 8-10）", 1033, 17, 68, 130, 11
    EDITTEXT 1001, 145, 65, 110, 14, ES_AUTOHSCROLL
    LTEXT "名前（1行に1件、完全一致）", 1034, 17, 86, 140, 11
    EDITTEXT 1012, 17, 97, 238, 18, ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT "番号・名前でレイヤーが重複する場合、1回だけ出力します。", 1035, 17, 117, 220, 10
    GROUPBOX "対象オブジェクト", 1036, 8, 132, 250, 40
    AUTOCHECKBOX "テキスト", 1013, 17, 143, 75, 12
    AUTOCHECKBOX "SRTrack Object", 1017, 100, 143, 155, 12
    AUTOCHECKBOX "セリフ準備（PSDToolkit）", 1014, 17, 157, 150, 12
    GROUPBOX "出力時刻", 1037, 8, 177, 250, 33
    LTEXT "オフセット（秒）", 1038, 17, 189, 90, 12
    EDITTEXT 1002, 195, 186, 60, 14, ES_AUTOHSCROLL
END

104 DIALOGEX 0, 0, 266, 215
STYLE WS_CHILD | DS_CONTROL
FONT 9, "Yu Gothic UI"
BEGIN
    GROUPBOX "字幕の整形", 1041, 8, 5, 250, 72
    LTEXT "最小字幕時間（秒、0.000以上）", 1042, 17, 17, 140, 12
    EDITTEXT 1016, 195, 14, 60, 14, ES_AUTOHSCROLL
    LTEXT "短い字幕は結合し、末尾はこの時間まで延長します。", 1043, 17, 35, 230, 20
    AUTOCHECKBOX "短い空白を埋める", 1026, 17, 53, 105, 12
    LTEXT "最小空白時間（秒）", 1049, 17, 65, 140, 12
    EDITTEXT 1027, 195, 62, 60, 14, ES_AUTOHSCROLL
    GROUPBOX "テキストの処理", 1044, 8, 82, 250, 58
    AUTOCHECKBOX "ルビをカッコ書きで残す", 1021, 17, 94, 120, 12
    AUTOCHECKBOX "絵文字をカッコ書きで残す", 1022, 145, 94, 120, 12
    AUTOCHECKBOX "待機・クリアを反映", 1025, 17, 108, 120, 12
    LTEXT "装飾用の制御文字、コメント、Lua スクリプトは削除されます。", 1046, 17, 125, 225, 10
    GROUPBOX "同時開始時の並び順", 1047, 8, 145, 250, 53
    AUTORADIOBUTTON "上のレイヤーから", 1023, 17, 157, 150, 12, WS_GROUP
    AUTORADIOBUTTON "下のレイヤーから", 1024, 17, 171, 110, 12
    LTEXT "同時に始まる字幕を結合する際の本文順です。", 1048, 17, 186, 225, 10
END

105 DIALOGEX 0, 0, 320, 218
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SRTrack Exporter"
FONT 9, "Yu Gothic UI"
BEGIN
    EDITTEXT 3001, 12, 12, 296, 160, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "共通ログをコピー", 3002, 120, 188, 96, 14
    DEFPUSHBUTTON "OK", IDOK, 226, 188, 50, 14
END

102 DIALOGEX 0, 0, 292, 232
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SRTrack 設定"
FONT 9, "Yu Gothic UI"
BEGIN
    CONTROL "", 2010, "SysTabControl32", WS_VISIBLE | WS_TABSTOP, 8, 5, 276, 196
    DEFPUSHBUTTON "OK", IDOK, 174, 210, 50, 14
    PUSHBUTTON "キャンセル", IDCANCEL, 232, 210, 50, 14
END

106 DIALOGEX 0, 0, 266, 175
STYLE WS_CHILD | DS_CONTROL
FONT 9, "Yu Gothic UI"
BEGIN
    GROUPBOX "Importer", -1, 8, 5, 250, 98
    AUTOCHECKBOX "動画ファイルドロップ時、同名の SRT ファイルがあれば読み込む", 2001, 17, 17, 232, 12
    AUTOCHECKBOX "SRT ファイル単体のドロップを読み込む", 2002, 17, 38, 210, 12
    AUTORADIOBUTTON "SRTrack Object", 2003, 31, 54, 110, 12, WS_GROUP
    AUTORADIOBUTTON "SRTrack Object (fix)", 2004, 139, 54, 105, 12
    LTEXT "Importer の設定変更は、AviUtl2 を再起動した後のファイルドロップから反映されます。", -1, 17, 80, 232, 20
    GROUPBOX "Preview", -1, 8, 114, 250, 34
    AUTOCHECKBOX "編集画面に字幕プレビューを表示する", 2008, 17, 126, 200, 12
END

107 DIALOGEX 0, 0, 266, 175
STYLE WS_CHILD | DS_CONTROL
FONT 9, "Yu Gothic UI"
BEGIN
    LTEXT "この起動中の診断情報を表示します。", -1, 10, 8, 240, 12
    LISTBOX 2005, 10, 24, 246, 118, LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "診断情報をコピー", 2006, 10, 151, 82, 14
    PUSHBUTTON "ログを消去", 2007, 100, 151, 60, 14
END
