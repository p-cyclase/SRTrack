#include <windows.h>
101 DIALOGEX 0, 0, 290, 281
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SRTrack Exporter"
FONT 9, "Yu Gothic UI"
BEGIN
    GROUPBOX "対象範囲", -1, 8, 5, 274, 32
    AUTORADIOBUTTON "シーン全体", 1010, 17, 18, 90, 12, WS_GROUP
    AUTORADIOBUTTON "レイヤーを指定", 1011, 125, 18, 120, 12
    LTEXT "レイヤー番号（例: 3, 5, 8-10）", -1, 10, 43, 200, 11
    EDITTEXT 1001, 10, 55, 270, 14, ES_AUTOHSCROLL
    LTEXT "レイヤー名（1行に1件、完全一致）", -1, 10, 74, 250, 11
    EDITTEXT 1012, 10, 87, 270, 47, ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    GROUPBOX "対象オブジェクト", -1, 8, 139, 274, 45
    AUTOCHECKBOX "標準テキスト", 1013, 17, 151, 100, 12
    AUTOCHECKBOX "セリフ準備", 1014, 145, 151, 105, 12
    AUTOCHECKBOX "SRTrack Object", 1017, 17, 166, 120, 12
    LTEXT "オフセット（秒）", -1, 10, 195, 110, 12
    EDITTEXT 1002, 153, 192, 82, 14, ES_AUTOHSCROLL
    LTEXT "短い字幕の結合閾値（秒）", -1, 10, 215, 140, 12
    EDITTEXT 1015, 153, 212, 82, 14, ES_AUTOHSCROLL
    LTEXT "末尾の最小表示時間（秒）", -1, 10, 235, 140, 12
    EDITTEXT 1016, 153, 232, 82, 14, ES_AUTOHSCROLL
    PUSHBUTTON "次へ", 1020, 173, 260, 50, 14
    PUSHBUTTON "キャンセル", IDCANCEL, 230, 260, 50, 14
END

102 DIALOGEX 0, 0, 292, 142
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SRTrack 設定"
FONT 9, "Yu Gothic UI"
BEGIN
    GROUPBOX "Importer", -1, 8, 7, 276, 126
    AUTOCHECKBOX "同名 SRT を自動で取り込む", 2001, 17, 20, 180, 12
    LTEXT "SRT ファイル単体をドロップしたとき", -1, 17, 43, 190, 12
    AUTORADIOBUTTON "SRTrack Object として配置", 2002, 27, 58, 170, 12, WS_GROUP
    AUTORADIOBUTTON "SRTrack Object (Standalone) として配置", 2003, 27, 75, 220, 12
    AUTORADIOBUTTON "処理しない（他のプラグインに渡す）", 2004, 27, 92, 220, 12
    DEFPUSHBUTTON "OK", IDOK, 177, 114, 50, 14
    PUSHBUTTON "キャンセル", IDCANCEL, 232, 114, 50, 14
END
